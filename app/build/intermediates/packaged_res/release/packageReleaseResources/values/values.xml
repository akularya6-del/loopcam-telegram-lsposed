    <color name="surface_dark">#0D0D0D</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B0B0B0</color>
    <color name="toggle_thumb_off">#616161</color>
    <color name="toggle_thumb_on">#00E676</color>
    <color name="toggle_track_off">#212121</color>
    <color name="toggle_track_on">#1B5E20</color>
    <string name="app_name">LoopCam</string>
    <string name="btn_select_video">SELECT VIDEO</string>
    <string name="label_no_video">No video selected</string>
    <string name="permission_denied">Storage permission denied. Cannot select video.</string>
