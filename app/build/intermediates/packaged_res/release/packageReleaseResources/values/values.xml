    <style name="Theme.LoopCam" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green_dark</item>
        <item name="colorOnPrimary">@color/bg_black</item>
        <item name="colorSurface">@color/surface_dark</item>
