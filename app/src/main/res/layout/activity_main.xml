<?xml version="1.0" encoding="utf-8"?>
<!-- LoopCam Dashboard — Pure black, single portrait screen -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".MainActivity">

    <!-- ── App Title ── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOOPCAM"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:fontFamily="monospace"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Version subtitle ── -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XPOSED MODULE v1.0"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.15"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- ── Video Preview (9:16 TextureView, centered) ── -->
    <TextureView
        android:id="@+id/textureViewPreview"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:background="#0A0A0A"
        app:layout_constraintTop_toBottomOf="@id/tvVersion"
        app:layout_constraintBottom_toTopOf="@id/tvFileName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="9:16"
        android:layout_marginTop="20dp"/>


    <!-- ── Placeholder text inside preview when no video ── -->
    <TextView
        android:id="@+id/tvPreviewPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NO VIDEO\nSELECTED"
        android:textColor="@color/status_inactive"
        android:textSize="12sp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="@id/textureViewPreview"
        app:layout_constraintBottom_toBottomOf="@id/textureViewPreview"
        app:layout_constraintStart_toStartOf="@id/textureViewPreview"
        app:layout_constraintEnd_toEndOf="@id/textureViewPreview"/>

    <!-- ── Video filename label ── -->
    <TextView
        android:id="@+id/tvFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/label_no_video"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:ellipsize="middle"
        android:singleLine="true"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnSelectVideo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"/>

    <!-- ── Select Video Button ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectVideo"
        style="@style/Widget.LoopCam.Button"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="@string/btn_select_video"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/switchFakeCamera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="28dp"/>

    <!-- ── Fake Camera Toggle ── -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchFakeCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toggle_label"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:thumbTint="@color/toggle_thumb_off"
        app:trackTint="@color/toggle_track_off"
        app:layout_constraintBottom_toTopOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"/>

    <!-- ── Status Indicator ── -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_inactive"
        android:textColor="@color/status_inactive"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.25"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_status_pill"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="36dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
